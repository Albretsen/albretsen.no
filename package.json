{
  "name": "albretsen-no",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "podman:build": "podman build -t albretsenno .",
    "podman:run": "podman run -d --name albretsenno -p 3000:3000 albretsenno",
    "podman:stop": "podman stop albretsenno || true",
    "podman:rm": "podman rm albretsenno || true",
    "podman:logs": "podman logs -f albretsenno",
    "podman:restart": "npm run podman:stop && npm run podman:rm && npm run podman:run"
  },
  "dependencies": {
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
